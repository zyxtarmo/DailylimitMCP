# Copy to .env and edit. DOMAIN must point (DNS A/AAAA record) at this server before first start.
DOMAIN=screentime.example.com
BASE_URL=https://screentime.example.com

# Time zone of the household. Must match the PCs' time zone: it decides what "today" is for bonuses, and
# which weekday/weekend limits apply. (Any IANA name, e.g. Europe/Tallinn.)
TIMEZONE=Europe/Tallinn

# Most extra minutes a parent can add per child per day through the connector.
MAX_BONUS_PER_DAY=60
# Defaults used when a child is created without explicit limits.
DEFAULT_WEEKDAY_MINUTES=120
DEFAULT_WEEKEND_MINUTES=180
# device_status marks an agent "stale" after this many seconds without a sync.
STALE_AFTER_SECONDS=300
